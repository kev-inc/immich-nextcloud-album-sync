immich_api_url: http://immich_server:2283/api
nextcloud_url: https://cloud.example.com

# ── ADVANCED ALTERNATIVE to SYNC_* env vars ──
# To use this file: unset SYNC_USERS and mount it at /app/config/users.yml
# (see README). The file then takes over completely; SYNC_* vars are ignored.
settings:
  # CREATE = only create/append, never deletes.
  # UPDATE = CREATE + prune stale albums (removed/renamed folders).
  # CLEANUP / DELETE_ALL = destructive teardown modes, need delete_confirm: true.
  mode: UPDATE
  # Mirror Nextcloud folder shares into .albumprops so matching Immich albums
  # are shared with the same users. Needs a per-user app password (see below).
  share_sync: true
  album_levels: 1
  album_separator: " "
  sync_interval_minutes: 60   # every user runs on this schedule
  # cron: "0 * * * *"          # alternative to the interval above
  chunk_size: 2000
  fetch_chunk_size: 1000
  log_level: INFO
  sync_mode: 0   # only used when mode is CREATE (UPDATE always forces 2)
  insecure: false
  find_assets_in_albums: false

# ── Users: identity + keys + folders only ──
# Keys come from .env: API_KEY_<USERNAME> and NC_APP_PASSWORD_<USERNAME>.
# Alternatives per user: api_key: "literal", api_key_file: /run/secrets/...,
# nextcloud_app_password: / nextcloud_app_password_file:.
users:
  - username: alice          # Immich account
    # nextcloud_user: alice  # Nextcloud account, if different from username
    root_paths:
      - /external_libs/alice_photos

  - username: bob
    # nextcloud_user: bob
    root_paths:
      - /external_libs/bob_photos
