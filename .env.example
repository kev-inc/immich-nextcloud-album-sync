TZ=Europe/Berlin
IMMICH_API_URL=http://immich_server:2283/api
NEXTCLOUD_URL=https://cloud.example.com
DASHBOARD_PORT=8080
# Image tag for sync-dashboard. Default builds/runs locally. Point it at your
# registry tag (e.g. ghcr.io/<user>/immich-sync-dashboard:latest) on machines
# where you don't want to build from source.
DASHBOARD_IMAGE=immich-sync-dashboard:latest
# ── Host / connection settings (keys live in config/users.yml) ──
# (API_KEY_<USER> / NC_APP_PASSWORD_<USER> env vars also work as fallback.)
# Nextcloud data on the HOST that holds one subfolder per user/library.
# Mounted to /external_libs in the container, so SYNC_ROOT_PATHS_* look
# like /external_libs/<user>_photos.
NEXTCLOUD_DATA_ROOT=/mnt/nextcloud-data
# Set to true to run one sync per user immediately on container start
RUN_IMMEDIATELY=false
